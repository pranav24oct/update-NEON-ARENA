# Neon Arena Environment Configuration

# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL="file:./dev.db"
SQLITE_FALLBACK=true

# Redis (optional, in-memory fallback enabled)
REDIS_URL="redis://localhost:6379"

# JWT & Authentication Secrets
JWT_ACCESS_SECRET="neon_arena_jwt_access_super_secret_key_2026_xyz!"
JWT_REFRESH_SECRET="neon_arena_jwt_refresh_super_secret_key_2026_abc!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:5173"
COOKIE_SECRET="neon_arena_cookie_secret_key_2026_qwe!"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Competitive Gaming Configuration
ELO_INITIAL_RATING=1200
ELO_K_FACTOR=32
TOURNAMENT_CHECKIN_MINUTES=15
